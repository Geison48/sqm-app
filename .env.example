# Copie para .env.local e preencha. Localmente, os valores saem de: npx supabase status
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (service role). NUNCA usar com prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# URL pública do app (usada nos links de e-mail e redirecionamentos de login).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "true" para mostrar o botão "Entrar com Microsoft" (requer o provedor Azure configurado no Supabase).
NEXT_PUBLIC_AUTH_AZURE_ENABLED=false
